[Unit]
Description=Arma 3 Headless Client %i
After=local-fs.target

[Service]
LimitCORE=1000000
User=steamcmd

EnvironmentFile=/etc/conf.d/arma3server/common-env
EnvironmentFile=/etc/conf.d/arma3server/client-env
EnvironmentFile=/etc/conf.d/arma3server/%i-env

WorkingDirectory=/opt/steamcmd/arma3server-%i/
ExecStart=/opt/steamcmd/arma3server-%i/arma3server_x64 $COMMONPARAMS $CLIENTPARAMS $OTHERPARAMS $PARAMS $MOD
Restart=always

[Install]
WantedBy=multi-user.target
